{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Creative Suite Resource Schema",
  "type": "object",
  "required": [
    "id",
    "name",
    "kind",
    "data",
    "version",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "cards",
        "worldbooks",
        "presets",
        "styles",
        "novels",
        "scripts",
        "summaries",
        "sessions",
        "stories"
      ]
    },
    "data": {
      "type": "object"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "type": "object"
    }
  }
}