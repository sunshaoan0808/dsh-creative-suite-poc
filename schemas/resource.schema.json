{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dsh.local/schemas/creative-suite/resource.schema.json",
  "title": "Creative Suite Resource",
  "description": "Unified resource record for DSH creative-suite shared store (P1-1).",
  "type": "object",
  "required": ["name"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "kind": {
      "type": "string",
      "enum": ["cards", "worldbooks", "presets", "styles", "novels", "scripts", "summaries", "sessions", "stories"]
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "source": { "type": "string", "maxLength": 128 },
    "version": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": ["integer", "string"], "description": "epoch ms (runtime) or ISO date-time" },
    "updatedAt": { "type": ["integer", "string"], "description": "epoch ms (runtime) or ISO date-time" },
    "data": { "type": ["object", "array", "string", "number", "boolean", "null"] },
    "lineage": {
      "type": "object",
      "properties": {
        "derivedFrom": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "id"],
            "properties": {
              "kind": { "type": "string" },
              "id": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "basedOn": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "id"],
            "properties": {
              "kind": { "type": "string" },
              "id": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "derivation": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
